# Copy to .env and fill in. pipeline.py and the dashboard load this file automatically.
# .env is git-ignored: never commit real credentials.

# --- Snowflake connection ---
SNOWFLAKE_ACCOUNT=ZELTXRI-OH62182        # account identifier (orgname-accountname also works)
SNOWFLAKE_USER=KARTHIK89
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=TPCH_DE                  # created by `pipeline.py load` if your role may create databases
SNOWFLAKE_SCHEMA=ANALYTICS                  # default dbt schema (models go to STAGING / INTERMEDIATE / MARTS / ANALYTICS)
SNOWFLAKE_RAW_SCHEMA=RAW                    # where ingestion lands the raw TPC-H tables

# --- Snowflake auth: pick ONE ---
# 1) Key-pair (recommended; works with MFA-enforced accounts)
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# 2) Password
SNOWFLAKE_PASSWORD=5xvKNcif9rcK7X8
# 3) Browser SSO: set SNOWFLAKE_AUTHENTICATOR=externalbrowser and leave the above empty
SNOWFLAKE_AUTHENTICATOR=snowflake
